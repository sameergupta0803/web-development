<%- include("partials/header") %>

<header class="jumbotron">
    <div class="container">
        <h1>Welcome to Hotel Manager</h1>
        <p>View our hand-picked hotels from all over the world</p>
        <p>
            <a class="btn btn-primary btn-lg" href="/hotels/new">Add New Hotel</a>
        </p>
    </div>
</header>

<div class="row text-center" style="display:flex; flex-wrap: wrap;">
    <% hotels.forEach(function(hotel){ %>
        <div class="col-md-3 col-sm-6">
            <div class="card mb-4 shadow-sm">
                <img class="card-img-top" src="<%= hotel.image %>" alt="Hotel Image">
                <div class="card-body">
                    <h5 class="card-title"><%= hotel.name %></h5>
                    <p class="card-text">$<%= hotel.price %>/night</p>
                    <a href="#" class="btn btn-sm btn-outline-secondary">More Info</a>
                </div>
            </div>
        </div>
    <% }); %>
</div>

<%- include("partials/footer") %>