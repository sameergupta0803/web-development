<%- include("partials/header") %>
<div class="row justify-content-center">
    <div class="col-md-6">
        <h1 class="text-center">Create New Hotel</h1>
        <form action="/hotels" method="POST" enctype="multipart/form-data">
            <div class="mb-3">
                <input class="form-control" type="text" name="name" placeholder="Hotel Name" required>
            </div>
            <div class="mb-3">
                <label>Upload Image</label>
                <input class="form-control" type="file" name="image" required>
            </div>
            <div class="mb-3">
                <input class="form-control" type="number" name="price" placeholder="Price" required>
            </div>
            <div class="mb-3">
                <input class="form-control" type="text" name="description" placeholder="Description">
            </div>
            <button class="btn btn-primary w-100">Submit!</button>
        </form>
    </div>
</div>
<%- include("partials/footer") %>